# Copiar para .env e ajustar valores.
# Nunca commitar o ficheiro .env.

# App
NODE_ENV=development
# Na Vercel, as URLs da app e do auth são calculadas automaticamente.
# Estes valores de localhost são apenas para desenvolvimento local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# PostgreSQL (Docker Compose local — ver docker-compose.yml)
DATABASE_URL="postgresql://agroconet:agroconet_dev@localhost:5432/agroconet?schema=public"

# Better Auth (gerar com: openssl rand -hex 32)
BETTER_AUTH_SECRET="trocar-por-segredo-com-pelo-menos-32-caracteres"
BETTER_AUTH_URL=http://localhost:3000
