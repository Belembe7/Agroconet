generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SELLER
  CUSTOMER
  DRIVER
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerApprovalDecision {
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  INACTIVE
  ARCHIVED
}

enum ProductUnit {
  KG
  G
  L
  ML
  BAG
  UNIT
  BOX
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum InventoryMovementType {
  IN
  OUT
  SALE
  RETURN
  ADJUSTMENT
  CANCELLED_ORDER
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  MPESA
  EMOLA
  CARD
  COD
  MOCK
}

enum PaymentStatus {
  INITIATED
  PENDING
  PENDING_COLLECTION
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentTransactionType {
  CHARGE
  REFUND
}

enum VehicleType {
  MOTORCYCLE
  CAR
  BICYCLE
  ON_FOOT
}

enum DriverStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  AVAILABLE
  BUSY
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  ACCEPTED
  EN_ROUTE_TO_PICKUP
  PICKED_UP
  EN_ROUTE_TO_CUSTOMER
  DELIVERED
  FAILED
  CANCELLED
}

enum DriverEarningStatus {
  PENDING
  PAID
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  REVERSED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
  WHATSAPP
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

/// Identity user — Better Auth core fields + Agroconet domain fields.
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String
  email               String     @unique
  emailVerified       Boolean    @default(false) @map("email_verified")
  image               String?
  /// Optional E.164 phone; retained for existing accounts and future use.
  phoneNumber         String?    @unique @map("phone")
  phoneNumberVerified Boolean    @default(false) @map("phone_number_verified")
  /// Legacy Argon2 hash; password auth uses Better Auth `Account.password`.
  passwordHash        String?    @map("password_hash")
  status              UserStatus @default(ACTIVE)
  phoneVerifiedAt     DateTime?  @map("phone_verified_at")
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  sessions                   Session[]
  accounts                   Account[]
  roles                      UserRole[]                 @relation("UserRoles")
  rolesGranted               UserRole[]                 @relation("GrantedBy")
  customer                   Customer?
  seller                     Seller?
  driver                     Driver?
  addresses                  Address[]
  carts                      Cart[]
  checkoutSessions           CheckoutSession[]
  orders                     Order[]
  favorites                  Favorite[]
  reviews                    Review[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  auditLogs                  AuditLog[]                 @relation("AuditActor")
  systemSettingsUpdated      SystemSetting[]            @relation("SystemSettingUpdatedBy")
  sellerDocumentsReviewed    SellerDocument[]           @relation("SellerDocumentReviewer")
  sellerApprovalsReviewed    SellerApproval[]           @relation("SellerApprovalReviewer")
  productsReviewed           Product[]                  @relation("ProductReviewer")
  inventoryMovements         InventoryMovement[]        @relation("InventoryMovementActor")
  orderStatusHistories       OrderStatusHistory[]       @relation("OrderStatusHistoryActor")
  deliveryStatusHistories    DeliveryStatusHistory[]    @relation("DeliveryStatusHistoryActor")
  driverDocumentsReviewed    DriverDocument[]           @relation("DriverDocumentReviewer")
  sellerPayoutsCreated       SellerPayout[]             @relation("SellerPayoutCreatedBy")

  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  role        Role
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user      User  @relation("UserRoles", fields: [userId], references: [id])
  grantedBy User? @relation("GrantedBy", fields: [grantedById], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  defaultAddressId String?  @map("default_address_id") @db.Uuid
  preferences      Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id])
  defaultAddress Address? @relation("DefaultAddress", fields: [defaultAddressId], references: [id])

  @@map("customers")
}

model Address {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  label          String
  recipientName  String    @map("recipient_name")
  phone          String
  province       String
  district       String
  neighborhood   String
  street         String?
  reference      String
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  zoneId         String?   @map("zone_id") @db.Uuid
  isDefault      Boolean   @default(false) @map("is_default")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user                  User              @relation(fields: [userId], references: [id])
  zone                  DeliveryZone?     @relation(fields: [zoneId], references: [id])
  defaultForCustomers   Customer[]        @relation("DefaultAddress")
  checkoutSessions      CheckoutSession[]

  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Sellers
// ---------------------------------------------------------------------------

model Seller {
  id                    String       @id @default(uuid()) @db.Uuid
  userId                String       @unique @map("user_id") @db.Uuid
  businessName          String       @map("business_name")
  legalName             String?      @map("legal_name")
  taxId                 String?      @map("tax_id")
  description           String?
  logoUrl               String?      @map("logo_url")
  phone                 String
  province              String
  district              String
  addressText           String       @map("address_text")
  latitude              Decimal?     @db.Decimal(10, 7)
  longitude             Decimal?     @db.Decimal(10, 7)
  status                SellerStatus @default(PENDING)
  commissionBpsOverride Int?         @map("commission_bps_override")
  pickupZoneId          String?      @map("pickup_zone_id") @db.Uuid
  slug                  String       @unique
  ratingAvg             Decimal      @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount           Int          @default(0) @map("rating_count")
  approvedAt            DateTime?    @map("approved_at")
  deletedAt             DateTime?    @map("deleted_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id])
  pickupZone   DeliveryZone?     @relation(fields: [pickupZoneId], references: [id])
  documents    SellerDocument[]
  approvals    SellerApproval[]
  products     Product[]
  sellerOrders SellerOrder[]
  reviews      Review[]
  payouts      SellerPayout[]
  commissions  Commission[]

  @@index([status])
  @@map("sellers")
}

model SellerDocument {
  id           String    @id @default(uuid()) @db.Uuid
  sellerId     String    @map("seller_id") @db.Uuid
  type         String
  storageKey   String    @map("storage_key")
  status       String
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  seller     Seller @relation(fields: [sellerId], references: [id])
  reviewedBy User?  @relation("SellerDocumentReviewer", fields: [reviewedById], references: [id])

  @@map("seller_documents")
}

model SellerApproval {
  id         String                 @id @default(uuid()) @db.Uuid
  sellerId   String                 @map("seller_id") @db.Uuid
  decision   SellerApprovalDecision
  reason     String?
  reviewerId String                 @map("reviewer_id") @db.Uuid
  createdAt  DateTime               @default(now()) @map("created_at")

  seller   Seller @relation(fields: [sellerId], references: [id])
  reviewer User   @relation("SellerApprovalReviewer", fields: [reviewerId], references: [id])

  @@map("seller_approvals")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id                   String    @id @default(uuid()) @db.Uuid
  parentId             String?   @map("parent_id") @db.Uuid
  name                 String
  slug                 String    @unique
  description          String?
  imageUrl             String?   @map("image_url")
  sortOrder            Int       @default(0) @map("sort_order")
  isActive             Boolean   @default(true) @map("is_active")
  requiresReview       Boolean   @default(false) @map("requires_review")
  defaultCommissionBps Int?      @map("default_commission_bps")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

/// search_vector (tsvector) generated column — add via raw SQL migration, not a Prisma field.
model Product {
  id              String        @id @default(uuid()) @db.Uuid
  sellerId        String        @map("seller_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  name            String
  slug            String        @unique
  description     String?
  brand           String?
  status          ProductStatus @default(DRAFT)
  rejectionReason String?       @map("rejection_reason")
  reviewedById    String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  ratingAvg       Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount     Int           @default(0) @map("rating_count")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  seller       Seller               @relation(fields: [sellerId], references: [id])
  category     Category             @relation(fields: [categoryId], references: [id])
  reviewedBy   User?                @relation("ProductReviewer", fields: [reviewedById], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  slugHistory  ProductSlugHistory[]
  favorites    Favorite[]
  reviews      Review[]

  @@index([status, categoryId])
  @@index([sellerId, status])
  @@map("products")
}

/// Partial unique index on (product_id) WHERE is_default — add via SQL migration.
model ProductVariant {
  id                 String      @id @default(uuid()) @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  sku                String      @unique
  label              String
  unit               ProductUnit
  unitSize           Decimal     @map("unit_size") @db.Decimal(12, 4)
  priceCents         Int         @map("price_cents")
  compareAtPriceCents Int?       @map("compare_at_price_cents")
  isDefault          Boolean     @default(false) @map("is_default")
  isActive           Boolean     @default(true) @map("is_active")
  lowStockThreshold  Int         @default(5) @map("low_stock_threshold")
  deletedAt          DateTime?   @map("deleted_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id])
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  storageKey String   @map("storage_key")
  alt        String?
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductSlugHistory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("product_slug_histories")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
  @@map("favorites")
}

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  sellerId    String       @map("seller_id") @db.Uuid
  orderItemId String       @unique @map("order_item_id") @db.Uuid
  rating      Int
  comment     String?
  status      ReviewStatus @default(PUBLISHED)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  seller    Seller    @relation(fields: [sellerId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// CHECK constraints on quantity columns — add via SQL migration.
model Inventory {
  variantId        String   @id @map("variant_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("inventories")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  variantId     String                @map("variant_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  balanceAfter  Int                   @map("balance_after")
  reason        String?
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id")
  actorUserId   String?               @map("actor_user_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  actorUser User?          @relation("InventoryMovementActor", fields: [actorUserId], references: [id])

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

model StockReservation {
  id                String                 @id @default(uuid()) @db.Uuid
  variantId         String                 @map("variant_id") @db.Uuid
  orderId           String?                @map("order_id") @db.Uuid
  checkoutSessionId String?                @map("checkout_session_id") @db.Uuid
  quantity          Int
  status            StockReservationStatus @default(ACTIVE)
  expiresAt         DateTime               @map("expires_at")
  createdAt         DateTime               @default(now()) @map("created_at")

  variant         ProductVariant   @relation(fields: [variantId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])
  checkoutSession CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])

  @@index([status, expiresAt])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Cart & checkout
// ---------------------------------------------------------------------------

model Cart {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @unique @map("user_id") @db.Uuid
  anonymousToken  String?   @unique @map("anonymous_token")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  quantity  Int

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model CheckoutSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  cartSnapshot   Json      @map("cart_snapshot")
  addressId      String?   @map("address_id") @db.Uuid
  deliveryOption String?   @map("delivery_option")
  paymentMethod  String?   @map("payment_method")
  step           String
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id])
  address           Address?           @relation(fields: [addressId], references: [id])
  stockReservations StockReservation[]

  @@map("checkout_sessions")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                      String      @id @default(uuid()) @db.Uuid
  number                  String      @unique
  userId                  String      @map("user_id") @db.Uuid
  status                  OrderStatus @default(PENDING)
  subtotalCents           Int         @map("subtotal_cents")
  deliveryTotalCents      Int         @map("delivery_total_cents")
  discountCents           Int         @default(0) @map("discount_cents")
  totalCents              Int         @map("total_cents")
  currency                String      @default("MZN")
  shippingAddressSnapshot Json        @map("shipping_address_snapshot")
  contactPhone            String      @map("contact_phone")
  idempotencyKey          String      @unique @map("idempotency_key")
  placedAt                DateTime?   @map("placed_at")
  cancelledAt             DateTime?   @map("cancelled_at")
  cancelReason            String?     @map("cancel_reason")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  user              User                 @relation(fields: [userId], references: [id])
  sellerOrders      SellerOrder[]
  payments          Payment[]
  statusHistory     OrderStatusHistory[]
  stockReservations StockReservation[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model SellerOrder {
  id               String            @id @default(uuid()) @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  sellerId         String            @map("seller_id") @db.Uuid
  status           SellerOrderStatus @default(PENDING)
  subtotalCents    Int               @map("subtotal_cents")
  deliveryFeeCents Int               @map("delivery_fee_cents")
  commissionCents  Int               @map("commission_cents")
  sellerNetCents   Int               @map("seller_net_cents")
  confirmedAt      DateTime?         @map("confirmed_at")
  readyAt          DateTime?         @map("ready_at")
  rejectionReason  String?           @map("rejection_reason")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  order       Order       @relation(fields: [orderId], references: [id])
  seller      Seller      @relation(fields: [sellerId], references: [id])
  items       OrderItem[]
  delivery    Delivery?
  commission  Commission?

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@map("seller_orders")
}

model OrderItem {
  id               String @id @default(uuid()) @db.Uuid
  sellerOrderId    String @map("seller_order_id") @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  productName      String @map("product_name")
  variantLabel     String @map("variant_label")
  sku              String
  unitPriceCents   Int    @map("unit_price_cents")
  quantity         Int
  lineTotalCents   Int    @map("line_total_cents")
  commissionBps    Int    @map("commission_bps")
  commissionCents  Int    @map("commission_cents")

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  review      Review?

  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id])
  actorUser User? @relation("OrderStatusHistoryActor", fields: [actorUserId], references: [id])

  @@map("order_status_histories")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider
  method            String
  status            PaymentStatus   @default(INITIATED)
  amountCents       Int             @map("amount_cents")
  currency          String          @default("MZN")
  idempotencyKey    String          @unique @map("idempotency_key")
  providerReference String?         @map("provider_reference")
  paidAt            DateTime?       @map("paid_at")
  failureCode       String?         @map("failure_code")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  order        Order                @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]

  @@unique([provider, providerReference])
  @@map("payments")
}

model PaymentTransaction {
  id                    String                 @id @default(uuid()) @db.Uuid
  paymentId             String                 @map("payment_id") @db.Uuid
  type                  PaymentTransactionType
  status                String
  amountCents           Int                    @map("amount_cents")
  providerTransactionId String?                @map("provider_transaction_id")
  rawResponse           Json?                  @map("raw_response")
  createdAt             DateTime               @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payment_transactions")
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  eventId        String    @map("event_id")
  signatureValid Boolean   @map("signature_valid")
  payload        Json
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")
  status         String

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Logistics
// ---------------------------------------------------------------------------

model DeliveryZone {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  province     String
  areas        Json
  baseFeeCents Int      @map("base_fee_cents")
  isActive     Boolean  @default(true) @map("is_active")
  polygon      Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses   Address[]
  sellers     Seller[]
  driverZones DriverZone[]
  deliveries  Delivery[]

  @@map("delivery_zones")
}

model Driver {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @unique @map("user_id") @db.Uuid
  vehicleType  VehicleType        @map("vehicle_type")
  plate        String?
  status       DriverStatus       @default(PENDING)
  availability DriverAvailability @default(OFFLINE)
  deletedAt    DateTime?          @map("deleted_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id])
  zones     DriverZone[]
  documents DriverDocument[]
  deliveries Delivery[]
  locations DriverLocation[]
  payouts   DriverPayout[]
  earnings  DriverEarning[]

  @@map("drivers")
}

model DriverZone {
  driverId String @map("driver_id") @db.Uuid
  zoneId   String @map("zone_id") @db.Uuid

  driver Driver       @relation(fields: [driverId], references: [id])
  zone   DeliveryZone @relation(fields: [zoneId], references: [id])

  @@id([driverId, zoneId])
  @@map("driver_zones")
}

model DriverDocument {
  id           String    @id @default(uuid()) @db.Uuid
  driverId     String    @map("driver_id") @db.Uuid
  type         String
  storageKey   String    @map("storage_key")
  status       String
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  driver     Driver @relation(fields: [driverId], references: [id])
  reviewedBy User?  @relation("DriverDocumentReviewer", fields: [reviewedById], references: [id])

  @@map("driver_documents")
}

model Delivery {
  id                     String         @id @default(uuid()) @db.Uuid
  sellerOrderId          String         @unique @map("seller_order_id") @db.Uuid
  driverId               String?        @map("driver_id") @db.Uuid
  status                 DeliveryStatus @default(UNASSIGNED)
  pickupAddressSnapshot  Json           @map("pickup_address_snapshot")
  dropoffAddressSnapshot Json           @map("dropoff_address_snapshot")
  zoneId                 String?        @map("zone_id") @db.Uuid
  feeCents               Int            @map("fee_cents")
  driverFeeCents         Int            @map("driver_fee_cents")
  confirmationCodeHash   String?        @map("confirmation_code_hash")
  confirmationMethod     String?        @map("confirmation_method")
  proofPhotoKey          String?        @map("proof_photo_key")
  signatureKey           String?        @map("signature_key")
  assignedAt             DateTime?      @map("assigned_at")
  acceptedAt             DateTime?      @map("accepted_at")
  pickedUpAt             DateTime?      @map("picked_up_at")
  deliveredAt            DateTime?      @map("delivered_at")
  failedReason           String?        @map("failed_reason")
  attempts               Int            @default(0)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  sellerOrder   SellerOrder             @relation(fields: [sellerOrderId], references: [id])
  driver        Driver?                 @relation(fields: [driverId], references: [id])
  zone          DeliveryZone?           @relation(fields: [zoneId], references: [id])
  statusHistory DeliveryStatusHistory[]
  locations     DriverLocation[]
  earning       DriverEarning?

  @@index([status, zoneId])
  @@index([driverId, status])
  @@map("deliveries")
}

model DeliveryStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  deliveryId  String          @map("delivery_id") @db.Uuid
  fromStatus  DeliveryStatus? @map("from_status")
  toStatus    DeliveryStatus  @map("to_status")
  actorUserId String?         @map("actor_user_id") @db.Uuid
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")

  delivery  Delivery @relation(fields: [deliveryId], references: [id])
  actorUser User?    @relation("DeliveryStatusHistoryActor", fields: [actorUserId], references: [id])

  @@map("delivery_status_histories")
}

model DriverLocation {
  id         String   @id @default(uuid()) @db.Uuid
  driverId   String   @map("driver_id") @db.Uuid
  deliveryId String?  @map("delivery_id") @db.Uuid
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  recordedAt DateTime @default(now()) @map("recorded_at")

  driver   Driver    @relation(fields: [driverId], references: [id])
  delivery Delivery? @relation(fields: [deliveryId], references: [id])

  @@map("driver_locations")
}

model DriverPayout {
  id          String    @id @default(uuid()) @db.Uuid
  driverId    String    @map("driver_id") @db.Uuid
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  totalCents  Int       @map("total_cents")
  status      String
  paidAt      DateTime? @map("paid_at")
  reference   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  driver   Driver          @relation(fields: [driverId], references: [id])
  earnings DriverEarning[]

  @@map("driver_payouts")
}

model DriverEarning {
  id         String              @id @default(uuid()) @db.Uuid
  driverId   String              @map("driver_id") @db.Uuid
  deliveryId String              @unique @map("delivery_id") @db.Uuid
  amountCents Int                @map("amount_cents")
  status     DriverEarningStatus @default(PENDING)
  payoutId   String?             @map("payout_id") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  driver   Driver        @relation(fields: [driverId], references: [id])
  delivery Delivery      @relation(fields: [deliveryId], references: [id])
  payout   DriverPayout? @relation(fields: [payoutId], references: [id])

  @@map("driver_earnings")
}

// ---------------------------------------------------------------------------
// Commissions & seller payouts
// ---------------------------------------------------------------------------

model SellerPayout {
  id          String    @id @default(uuid()) @db.Uuid
  sellerId    String    @map("seller_id") @db.Uuid
  totalCents  Int       @map("total_cents")
  status      String
  method      String?
  reference   String?
  paidAt      DateTime? @map("paid_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  seller      Seller       @relation(fields: [sellerId], references: [id])
  createdBy   User?        @relation("SellerPayoutCreatedBy", fields: [createdById], references: [id])
  commissions Commission[]

  @@map("seller_payouts")
}

model Commission {
  id              String           @id @default(uuid()) @db.Uuid
  sellerOrderId   String           @unique @map("seller_order_id") @db.Uuid
  sellerId        String           @map("seller_id") @db.Uuid
  grossCents      Int              @map("gross_cents")
  commissionCents Int              @map("commission_cents")
  netCents        Int              @map("net_cents")
  status          CommissionStatus @default(PENDING)
  availableAt     DateTime?        @map("available_at")
  payoutId        String?          @map("payout_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  sellerOrder SellerOrder   @relation(fields: [sellerOrderId], references: [id])
  seller      Seller        @relation(fields: [sellerId], references: [id])
  payout      SellerPayout? @relation(fields: [payoutId], references: [id])

  @@map("commissions")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  notificationId    String              @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            String
  attempts          Int                 @default(0)
  providerMessageId String?             @map("provider_message_id")
  error             String?
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

model NotificationPreference {
  userId  String              @map("user_id") @db.Uuid
  channel NotificationChannel
  type    String
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, channel, type])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model Coupon {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  type          String
  value         Int
  minOrderCents Int?      @map("min_order_cents")
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  perUserLimit  Int?      @map("per_user_limit")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("coupons")
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  updatedBy User? @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("system_settings")
}
